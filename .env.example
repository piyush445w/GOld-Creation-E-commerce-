# Flask
FLASK_ENV=development
SECRET_KEY=replace-with-strong-random-key

# Database
# For local Docker: mysql+pymysql://root:root@localhost:3306/gold_creation
# For Railway: mysql+pymysql://user:pass@host:3306/railway
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/gold_creation

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secure-password-here

# Mail (Flask-Mail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Twilio (SMS/WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# App
APP_URL=http://localhost:5000
